      "parameters": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "YYYY-MM-DD；默认北京时间今天"
          },
          "campus": {
            "type": "string",
            "description": "校区名称包含的文本，如中关村、通州"
          },
          "venue": {
            "type": "string",
            "description": "楼宇名称包含的文本，如立德楼"
          },
          "type": {
            "type": "string",
            "description": "舱型名称包含的文本，如单人、多人"
          },
          "minutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440,
            "description": "至少连续分钟数；0 表示只按官网最小时长"
          },
          "from": {
            "type": "string",
            "description": "开始 HH:MM，须与 to 成对，且符合官网时间格"
          },
          "to": {
            "type": "string",
            "description": "结束 HH:MM；同一舱须完整覆盖，最晚 24:00"
          }
        },
        "additionalProperties": false
      },
      "evidence": "evidence/public-validation.json",
      "verifiedScope": "中关村单人舱全部88间，五组目录和时段"
    },
