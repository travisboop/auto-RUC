      }
    },
    {
      "id": "forms.submit",
      "name": "提交有流程的表单申请",
      "description": "提交有流程的表单申请。先读取 forms.schema 和 forms.context，根据当前字段构造 bizData；本能力仅离线验证，不曾在真实平台提交。",
      "platform": "forms",
      "readOnly": false,
      "verification": "source_verified_offline_only",
      "parameters": {
        "type": "object",
        "properties": {
          "actId": {
            "type": "integer",
            "minimum": 1
          },
          "submission": {
            "type": "object",
            "properties": {
              "bizData": {
                "type": "object",
                "additionalProperties": true
              },
              "nextFlow": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": true
                },
                "description": "根据本次 context.connectors 和页面流程选择构造的分支数组"
              },
              "presetApprovers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "bizData",
              "nextFlow"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "required": [
          "actId",
          "submission"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/easyform3/api/activityRuntime/start/{actId}",
        "body": {
          "$param": "submission"
        }
      },
      "response": {
        "checks": [
          {
            "path": [
              "code"
            ],
            "equals": "success"
          }
        ],
        "dataPath": [
          "result",
          "data"
        ]
      },
      "evidence": {
        "source": "https://my.ruc.edu.cn/easyform3/assets/js/runtime.js",
        "checkedOn": "2026-11-26"
      },
      "receiptQuery": "forms.my_submissions"
    },
