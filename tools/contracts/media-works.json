{
  "profiles": [
    {
      "id": "media_works",
      "origin": "https://mediaview.ruc.edu.cn",
      "entry": "https://mediaview.ruc.edu.cn/",
      "auth": {
        "kind": "public"
      },
      "documentPaths": [
        "/",
        "/index.html",
        "/detail.html"
      ]
    },
    {
      "id": "media_account",
      "origin": "https://mediaview.ruc.edu.cn",
      "entry": "https://mediaview.ruc.edu.cn/user.html",
      "documentPaths": [
        "/user.html",
        "/project.html"
      ],
      "auth": {
        "kind": "cas_cookie",
        "service": "https://cas.ruc.edu.cn/cas/oauth2.0/callbackAuthorize",
        "entryDiscovery": {
          "path": "/studentUser/weirda/auth-url",
          "query": {
            "type": 2
          },
          "responsePath": [
            "data",
            "auth_url"
          ],
          "acceptedStatuses": [
            200
          ]
        },
        "exchange": {
          "parameters": {
            "code": {
              "source": "query",
              "parameter": "code"
            }
          },
          "request": {
            "method": "GET",
            "path": "/studentUser/weirda/oauth/callback",
            "query": {
              "type": 2,
              "code": {
                "$param": "code"
              }
            }
          },
          "response": {
            "checks": [
              {
                "path": [
                  "code"
                ],
                "equals": 0
              },
              {
                "path": [
                  "data",
                  "token"
                ],
                "type": "string"
              }
            ]
          }
        },
        "tokenBindings": [
          {
            "source": "response",
            "path": [
              "data",
              "token"
            ],
            "header": "x-token"
          }
        ],
        "assertion": {
          "path": "/studentUser/getUserInfo",
          "response": {
            "checks": [
              {
                "path": [
                  "code"
                ],
                "equals": 0
              },
              {
                "path": [
                  "data",
                  "ID"
                ],
                "type": "integer"
              }
            ]
          }
        }
      }
    }
  ],
  "capabilities": [
    {
      "id": "media.years",
      "name": "新闻传播作品平台作品年份",
      "description": "新闻传播作品平台作品年份；读取接口不提交作品或修改个人资料。",
      "platform": "media_works",
      "readOnly": true,
      "parameters": {
        "type": "object",
        "properties": {
          "type": {
            "type": "integer",
            "enum": [
              1,
              2,
              4,
              5,
              6
