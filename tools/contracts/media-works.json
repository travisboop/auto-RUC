            "description": "作品栏目，使用官网当前栏目编号"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/studentUser/getYearList",
        "query": {
          "type": {
            "$param": "type"
          }
        }
      },
      "response": {
        "checks": [
          {
            "path": [
