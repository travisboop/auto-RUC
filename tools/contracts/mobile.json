      "name": "校园卡指定月份流水和统计",
      "description": "按当前月查询页面的 POST 读取流水和统计；接口不提供总数，未声明跨页完整性。分类从 mobile.card_history_types 取得。",
      "platform": "mobile_campus",
      "readOnly": true,
      "parameters": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string",
            "pattern": "\\d{4}-(0[1-9]|1[0-2])"
          },
          "tradetype": {
            "type": "string",
            "pattern": "-?[0-9]+",
            "default": "-1"
          }
        },
        "required": [
          "month"
        ],
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/datalook/wap/default/history",
        "encoding": "form",
        "body": {
          "month": {
            "$param": "month"
          },
          "tradetype": {
            "$param": "tradetype"
          },
          "page": 1
        }
      },
