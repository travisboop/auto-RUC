{
  "profiles": [
    {
      "id": "philosophy_rooms",
      "origin": "https://zxyhy.ruc.edu.cn",
      "entry": "https://zxyhy.ruc.edu.cn/web/auth",
      "documentPaths": [
        "/web/auth",
        "/web/auth/callback",
        "/web/rooms",
        "/web/my-bookings"
      ],
      "auth": {
        "kind": "cas_cookie",
        "service": "https://cas.ruc.edu.cn/cas/oauth2.0/callbackAuthorize",
        "entryDiscovery": {
          "path": "/api/auth/oauth/url",
          "responsePath": [
            "data",
            "authorizeUrl"
          ],
          "acceptedStatuses": [
            200
          ]
        },
        "upgradeHttpPaths": [
          "/web/auth/callback"
        ],
        "exchange": {
          "parameters": {
            "code": {
              "source": "query",
              "parameter": "code"
            },
            "state": {
              "source": "query",
              "parameter": "state"
            }
          },
          "request": {
            "method": "GET",
            "path": "/api/auth/oauth/callback",
            "query": {
              "code": {
                "$param": "code"
              },
              "state": {
                "$param": "state"
              }
            }
          },
          "response": {
            "checks": [
              {
                "path": [
                  "code"
                ],
                "equals": 200
              },
              {
                "path": [
                  "data",
                  "token"
                ],
                "type": "string"
              },
              {
                "path": [
                  "data",
                  "user",
                  "id"
                ],
                "type": "integer"
              }
            ]
          }
        },
        "tokenBindings": [
          {
            "source": "response",
            "path": [
              "data",
              "token"
            ],
            "header": "Authorization",
            "prefix": "Bearer "
          }
        ],
        "assertion": {
          "path": "/api/client/bookings/my",
          "response": {
            "checks": [
              {
                "path": [
                  "code"
                ],
                "equals": 200
              },
              {
                "path": [
                  "data"
                ],
                "type": "array"
              }
            ],
            "dataPath": [
              "data"
            ]
          }
        }
      }
    }
  ],
