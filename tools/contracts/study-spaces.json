    {
      "id": "study.rooms",
      "name": "研学空间房间和座位余量",
      "description": "研学空间房间和座位余量；保留官网返回字段。",
      "platform": "study_spaces",
      "readOnly": true,
      "parameters": {
        "type": "object",
        "properties": {
          "buildingId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "floorId": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "currentPage": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "beginMinute": {
            "type": "integer",
            "minimum": -1,
            "maximum": 1440,
            "default": -1
          },
          "endMinute": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440,
            "default": 0
          }
        },
        "required": [
          "buildingId",
          "date"
        ],
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/jsq/static/frontApi/res/findRoomDuration/{buildingId}/{date}",
        "body": {
          "floorId": {
            "$param": "floorId"
          },
          "currentPage": {
            "$param": "currentPage"
          },
          "pageSize": {
            "$param": "pageSize"
          },
          "beginMinute": {
            "$param": "beginMinute"
          },
          "endMinute": {
            "$param": "endMinute"
          },
          "minMinute": 0,
          "power": false,
          "roomType": false,
          "windows": false,
          "sortField": "",
          "sortType": ""
        }
      },
      "response": {
        "checks": [
          {
            "path": [
              "status"
            ],
            "equals": true
          },
          {
            "path": [
              "code"
            ],
            "equals": 200
          }
        ],
        "dataPath": [
          "data"
        ],
        "pagination": {
          "itemsPath": [
            "data",
            "pageList"
          ],
          "totalPath": [
            "data",
            "totalCount"
          ],
          "identityPath": [
            "id"
          ],
          "pageParameter": "currentPage",
          "firstPage": 1
        }
      },
      "verification": "fresh_session_verified",
      "evidence": {
        "source": "https://yxkj.ruc.edu.cn/jsq-v/static/js/app.29ab407eb1d2a2c5382f.js",
